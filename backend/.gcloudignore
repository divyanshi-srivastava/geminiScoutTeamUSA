# Files uploaded to Cloud Build but not needed in the deployed container.
# Same syntax as .gitignore.

# ── Python build / runtime artifacts ──
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# ── Local credentials & env (Cloud Run uses the service account + env vars) ──
scout-credentials.json
.env
.env.*

# ── Tests ──
tests/

# ── Benchmark harness — only run locally against a live backend, never inside the deployed image ──
benchmark/

# ── VCS ──
.git/
.gitignore

# ── IDE / OS ──
.vscode/
.idea/
.DS_Store
*.swp

# ── Logs ──
*.log
